# Copy to .env for local development. Never commit real values.
# Supabase (create the project in the Supabase dashboard, then run db/schema.sql)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Razorpay (test keys first; live keys only via Vercel environment variables)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# WhatsApp Cloud API (reconfirm reminders, callback alerts) — server-side only
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
